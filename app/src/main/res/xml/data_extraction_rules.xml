<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Stream keys and chat tokens live in app-private storage and must never be backed up. -->
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
